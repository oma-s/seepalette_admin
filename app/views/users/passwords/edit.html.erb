<section class="portal-auth-card">
  <p class="portal-eyebrow">Zugang</p>
  <h1>Neues Passwort</h1>
  <%= form_for resource, as: resource_name, url: password_path(resource_name), html: {method: :put, class: "portal-form"} do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= form.hidden_field :reset_password_token %>
    <div class="portal-field"><%= form.label :password, "Neues Passwort" %><%= form.password_field :password, autofocus: true, autocomplete: "new-password", required: true %></div>
    <div class="portal-field"><%= form.label :password_confirmation, "Passwort bestätigen" %><%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %></div>
    <%= form.submit "Passwort speichern", class: "portal-button portal-button--full" %>
  <% end %>
</section>
